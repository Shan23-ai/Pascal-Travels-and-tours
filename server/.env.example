# ==== Server ====
PORT=3000
NODE_ENV=development

# ==== Database (PostgreSQL) ====
# Use SQLite via store.js if you don't have Postgres yet (demo mode)
DATABASE_URL=postgres://user:pass@localhost:5432/pascal_travels
DB_ENABLED=false

# ==== PesaLink Aggregator (SasaPay / Cellulant Tingg) ====
# Choose provider: 'sasapay' | 'tingg' | 'none'
PESALINK_PROVIDER=none
PESALINK_API_BASE=https://sandbox.sasapay.app/api/v1
PESALINK_CLIENT_ID=your_sasapay_client_id
PESALINK_CLIENT_SECRET=your_sasapay_client_secret
PESALINK_MERCHANT_CODE=your_merchant_code
PESALINK_WEBHOOK_SECRET=your_webhook_signing_secret

# ==== Manual DIB Bank Details (fallback when no aggregator) ====
DIB_BANK_NAME=Dubai Islamic Bank (Kenya)
DIB_ACCOUNT_NAME=Pascal Travels & Tour Ltd
DIB_ACCOUNT_NUMBER=0101234567890
DIB_BRANCH=Tom Mboya Street Branch, Nairobi
DIB_SWIFT_CODE=DIBKKENA
DIB_PESALINK_MERCHANT_ID=178543

# ==== Western Union ====
# Mode: 'mock' uses simulated MTCN verification for development (no real mTLS)
# Mode: 'live' uses real WU API with mTLS certificates
WU_MODE=mock
WU_API_BASE=https://api.westernunion.com
WU_CLIENT_ID=your_wu_client_id
WU_CLIENT_SECRET=your_wu_client_secret
WU_SCOPE=cts-api-branch-payment
WU_GRANT_TYPE=client_credentials
WU_CERT_PATH=./certs/wu_client_cert.p12
WU_CERT_PASSPHRASE=change_me
WU_BANK_ID=1221
WU_AGENT_ID=99887766
WU_AGENT_BRANCH=NAIROBI-001
WU_AGENT_COUNTRY=KE
WU_AGENT_TERMINAL=WEB01
WU_ACCOUNT_NUMBER=PascalTravelsDoc
WU_WEBHOOK_SECRET=your_wu_webhook_secret

# ==== Stripe (existing card) ====
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CURRENCY=kes

# ==== App ====
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
